# ---------------------------------------------------------------------------
# TopoForge-AI configuration. Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------
TOPOFORGE_ENV=development
TOPOFORGE_LOG_LEVEL=INFO
TOPOFORGE_LOG_FORMAT=json

# --- API ---
TOPOFORGE_API__HOST=0.0.0.0
TOPOFORGE_API__PORT=8000
TOPOFORGE_API__CORS_ORIGINS=["http://localhost:3000"]

# --- Database ---
TOPOFORGE_DATABASE__URL=postgresql+asyncpg://topoforge:topoforge@localhost:5432/topoforge

# --- Object storage: local | s3 ---
TOPOFORGE_STORAGE__BACKEND=local
TOPOFORGE_STORAGE__LOCAL_ROOT=./var/storage
TOPOFORGE_STORAGE__S3_BUCKET=
TOPOFORGE_STORAGE__S3_PREFIX=topoforge/

# --- Vision ---
# INTEGRATION POINT: drop the supplied YOLO weights here and set this path.
TOPOFORGE_VISION__YOLO_WEIGHTS_PATH=./models/yolo/network-components.pt
# yolo | stub | null
TOPOFORGE_VISION__DETECTOR_BACKEND=stub
TOPOFORGE_VISION__DEVICE=cpu           # cpu | cuda
TOPOFORGE_VISION__DETECTION_CONFIDENCE_THRESHOLD=0.25
# paddle | tesseract | stub | null
TOPOFORGE_VISION__OCR_BACKEND=stub
TOPOFORGE_VISION__OCR_LANGUAGE=en
# hough | stub | null
TOPOFORGE_VISION__CONNECTOR_BACKEND=hough
TOPOFORGE_VISION__MAX_IMAGE_PIXELS=40000000
TOPOFORGE_VISION__MAX_UPLOAD_BYTES=26214400

# --- LLM (prompt mode only; the RAG has its own provider) ---
TOPOFORGE_LLM__PROVIDER=stub           # openai | anthropic | stub
TOPOFORGE_LLM__MODEL=claude-sonnet-5
TOPOFORGE_LLM__TEMPERATURE=0.0
TOPOFORGE_LLM__MAX_TOKENS=8192
TOPOFORGE_LLM__TIMEOUT_SECONDS=120
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- RAG (external net2tf_v3) ---
# legacy_net2tf | stub
TOPOFORGE_RAG__BACKEND=stub
# Absolute path to the RAG checkout, or ./external/rag after sync_external_rag.sh
TOPOFORGE_RAG__PATH=./external/rag
TOPOFORGE_RAG__KB_DIR=
TOPOFORGE_RAG__INDEX_DIR=./var/rag/index
TOPOFORGE_RAG__GENERATED_DIR=./var/rag/generated
TOPOFORGE_RAG__ENABLE_ANSIBLE=false
TOPOFORGE_RAG__TIMEOUT_SECONDS=900
GROQ_API_KEY=

# --- Orchestration ---
# memory | sqlite | postgres
TOPOFORGE_ORCHESTRATION__CHECKPOINTER=sqlite
TOPOFORGE_ORCHESTRATION__SQLITE_PATH=./var/checkpoints.sqlite

# --- Jobs ---
TOPOFORGE_JOBS__BACKEND=inprocess      # inprocess | sqs
TOPOFORGE_JOBS__SQS_QUEUE_URL=

# --- Deployment ---
# terraform | stub
TOPOFORGE_DEPLOYMENT__BACKEND=stub
TOPOFORGE_DEPLOYMENT__TERRAFORM_BINARY=terraform
TOPOFORGE_DEPLOYMENT__WORKSPACE_ROOT=./var/deployments
TOPOFORGE_DEPLOYMENT__ALLOW_APPLY=false
TOPOFORGE_DEPLOYMENT__AWS_REGION=eu-west-1
# Prefer role assumption over static keys.
TOPOFORGE_DEPLOYMENT__AWS_ROLE_ARN=
